# Copy this file to .env. Never commit real secrets.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAILS=owner@example.com
GEMINI_API_KEY=replace-with-your-google-ai-api-key
GEMINI_MODEL=gemini-3.6-flash
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=studyai
JOB_QUEUE_MODE=rq
DIRECT_MEDIA_PROCESSING=false
MAX_UPLOAD_GB=5
UPLOAD_CHUNK_MB=8
MIN_FREE_DISK_MB=64
TRANSCRIPTION_SEGMENT_MINUTES=30
TRANSCRIPTION_OVERLAP_SECONDS=5
SEGMENT_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT_SECONDS=600
GEMINI_FILE_READY_TIMEOUT_SECONDS=120
GEMINI_FILE_POLL_SECONDS=2
AI_INPUT_TOKEN_BUDGET=700000
STALE_UPLOAD_HOURS=24
FAILED_MEDIA_RETENTION_HOURS=24
SESSION_LIFETIME_DAYS=30
WEB_DOWNLOAD_TIMEOUT_SECONDS=30
PASSWORD_RESET_MAX_AGE_SECONDS=3600
MAIL_DELIVERY_MODE=console
MAIL_FROM=StudyAI <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# DATABASE_PATH=instance/studyai.sqlite3
# UPLOAD_ROOT=instance/uploads
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
